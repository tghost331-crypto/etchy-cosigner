# Etchy ICP co-signer build + test image (no secrets inside).
#   docker build -f ic/Dockerfile.build -t etchy-ic-build ic
FROM rust:1.90-slim-bookworm
RUN apt-get update \
 && apt-get install -y --no-install-recommends clang llvm curl ca-certificates gzip pkg-config \
 && rm -rf /var/lib/apt/lists/*
RUN rustup target add wasm32-unknown-unknown
# PocketIC server: a local Internet Computer for integration tests
# (threshold Schnorr test keys, deterministic). Same major as the crate.
ARG POCKET_IC_VERSION=16.1.0
RUN curl -fsSL -o /tmp/pocket-ic.gz \
      "https://github.com/dfinity/pocketic/releases/download/${POCKET_IC_VERSION}/pocket-ic-x86_64-linux.gz" \
 && echo "131219d90dcf9bf6f3ed8ee02d8f55504ea24a6db382f5680675b7bd6b7ed3bf  /tmp/pocket-ic.gz" | sha256sum -c - \
 && gunzip /tmp/pocket-ic.gz && mv /tmp/pocket-ic /usr/local/bin/pocket-ic && chmod +x /usr/local/bin/pocket-ic
ENV POCKET_IC_BIN=/usr/local/bin/pocket-ic
# Bitcoin Core (regtest only): checks the real custody scripts end to end.
ARG BITCOIN_VERSION=28.1
RUN cd /tmp \
 && curl -fsSL -O "https://bitcoincore.org/bin/bitcoin-core-${BITCOIN_VERSION}/bitcoin-${BITCOIN_VERSION}-x86_64-linux-gnu.tar.gz" \
 && curl -fsSL -O "https://bitcoincore.org/bin/bitcoin-core-${BITCOIN_VERSION}/SHA256SUMS" \
 && grep " bitcoin-${BITCOIN_VERSION}-x86_64-linux-gnu.tar.gz\$" SHA256SUMS | sha256sum -c - \
 && tar -xzf "bitcoin-${BITCOIN_VERSION}-x86_64-linux-gnu.tar.gz" \
 && install -m 0755 "bitcoin-${BITCOIN_VERSION}/bin/bitcoind" "bitcoin-${BITCOIN_VERSION}/bin/bitcoin-cli" /usr/local/bin/ \
 && rm -rf /tmp/bitcoin-* /tmp/SHA256SUMS
ENV CC_wasm32_unknown_unknown=clang
ENV AR_wasm32_unknown_unknown=llvm-ar
WORKDIR /work
